{
  "name": "slotlock",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @slotlock/api dev",
    "dev:web": "pnpm --filter @slotlock/web dev",
    "build": "pnpm --filter @slotlock/api build && pnpm --filter @slotlock/web build",
    "test": "pnpm --filter @slotlock/api test",
    "db:generate": "pnpm --filter @slotlock/api db:generate",
    "db:migrate": "pnpm --filter @slotlock/api db:migrate",
    "db:seed": "pnpm --filter @slotlock/api db:seed"
  },
  "packageManager": "pnpm@12.14.0"
}
